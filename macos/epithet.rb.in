# Generated by epithet-packaging. Binary archives are hosted separately from this tap.
class Epithet < Formula
  desc "SSH certificate management"
  homepage @@HOMEPAGE@@
  version @@VERSION@@
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url @@ARM64_URL@@
      sha256 @@ARM64_SHA256@@
    else
      url @@AMD64_URL@@
      sha256 @@AMD64_SHA256@@
    end
  end

  depends_on :macos

  def install
    bin.install "epithet"
  end

  def caveats
    <<~EOS
      To start the agent:
        brew services start epithet
    EOS
  end

  service do
    run [opt_bin/"epithet", "--log-file=#{Dir.home}/Library/logs/dev.epithet/agent.log", "agent"]
    keep_alive true
    process_type :background
  end

  test do
    system bin/"epithet", "--version"
  end
end
